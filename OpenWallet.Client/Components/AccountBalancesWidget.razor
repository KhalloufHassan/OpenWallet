@using OpenWallet.Shared.DTOs

<div class="widget-card">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
        <h6 class="mb-0 fw-semibold">Accounts</h6>
        @if (Dashboard.TotalsByCurrency.Count > 1)
        {
            <div class="acct-currency-tabs">
                @foreach (CurrencyTotalDto total in Dashboard.TotalsByCurrency)
                {
                    <button type="button"
                            class="acct-currency-tab @(total.Currency == selectedCurrency ? "active" : "")"
                            @onclick="() => selectedCurrency = total.Currency">
                        @total.Currency
                    </button>
                }
            </div>
        }
    </div>

    @if (Dashboard.Accounts.Count == 0)
    {
        <p class="text-muted small mb-0">No accounts yet.</p>
    }
    else
    {
        <div class="acct-hero">
            @if (IsMasked)
            {
                <div class="acct-hero-value masked">•••••</div>
            }
            else
            {
                <div class="acct-hero-value @(SelectedTotal < 0 ? "amount-negative" : "")">
                    @SelectedTotal.ToString("N2")
                </div>
            }
            <div class="acct-hero-label">@selectedCurrency total</div>
        </div>

        <div class="acct-chip-strip">
            @foreach (AccountDto account in VisibleAccounts)
            {
                <button type="button"
                        class="acct-chip @(OnAccountClick.HasDelegate ? "acct-chip--clickable" : "")"
                        @onclick="() => OnAccountClick.InvokeAsync(account.Id)">
                    <span class="acct-chip-name">
                        <span class="account-color-dot" style="background-color: @account.Color"></span>
                        <span class="text-truncate">@account.Name</span>
                    </span>
                    <span class="acct-chip-value @(account.CurrentBalance < 0 ? "amount-negative" : "") @(IsMasked ? "masked" : "")">
                        @account.CurrentBalance.ToString("N2")
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardDto Dashboard { get; set; } = new();
    [Parameter] public bool IsMasked { get; set; }
    [Parameter] public EventCallback<int> OnAccountClick { get; set; }

    string selectedCurrency = string.Empty;

    decimal SelectedTotal => Dashboard.TotalsByCurrency
        .FirstOrDefault(t => t.Currency == selectedCurrency)?.Total ?? 0m;

    IEnumerable<AccountDto> VisibleAccounts => Dashboard.Accounts
        .Where(a => a.Currency == selectedCurrency);

    protected override void OnParametersSet()
    {
        if (Dashboard.TotalsByCurrency.Any(t => t.Currency == selectedCurrency))
            return;

        selectedCurrency = Dashboard.TotalsByCurrency.Count > 0
            ? Dashboard.TotalsByCurrency[0].Currency
            : string.Empty;
    }
}
